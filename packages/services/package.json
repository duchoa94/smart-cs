{
  "name": "@smart-cs/services",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/env.js",
      "types": "./dist/config/env.d.ts"
    },
    "./cache": {
      "import": "./dist/cache/index.js",
      "types": "./dist/cache/index.d.ts"
    },
    "./vector": {
      "import": "./dist/vector/index.js",
      "types": "./dist/vector/index.d.ts"
    },
    "./ai": {
      "import": "./dist/ai/index.js",
      "types": "./dist/ai/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@smart-cs/types": "workspace:*",
    "@smart-cs/db": "workspace:*",
    "@anthropic-ai/sdk": "^0.52.0",
    "openai": "^4.103.0",
    "@zilliz/milvus2-sdk-node": "^2.5.5",
    "ioredis": "^5.6.1",
    "bullmq": "^5.52.2",
    "zod": "^3.25.28",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "typescript": "^5.8.3"
  }
}
