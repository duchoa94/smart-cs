# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
WIDGET_CDN_URL=http://localhost:3001

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://smart_cs:smart_cs@localhost:5432/smart_cs
DATABASE_POOL_SIZE=10

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_DB=1

# ── Milvus ────────────────────────────────────────────────────────────────────
MILVUS_ADDRESS=localhost:19530
MILVUS_TOKEN=

# ── AI Providers ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Encryption ────────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting channel credentials (32 bytes hex)
ENCRYPTION_KEY=change-me-64-hex-chars-here-000000000000000000000000000000

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# For S3:
# STORAGE_PROVIDER=s3
# AWS_REGION=ap-southeast-1
# AWS_BUCKET=smart-cs-uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Zalo (per channel, stored in DB — these are defaults/dev values) ──────────
# ZALO_OA_ID=
# ZALO_ACCESS_TOKEN=
# ZALO_SECRET_KEY=

# ── WhatsApp Business API ─────────────────────────────────────────────────────
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
